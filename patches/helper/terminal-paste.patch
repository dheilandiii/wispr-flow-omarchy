+fn is_terminal_class(class: &str) -> bool {
+    let class = class.to_ascii_lowercase();
+    matches!(
+        class.as_str(),
+        "alacritty"
+            | "dev.warp.warp"
+            | "foot"
+            | "kitty"
+            | "org.wezfurlong.wezterm"
+            | "xterm"
+            | "urxvt"
+            | "com.mitchellh.ghostty"
+    ) || class.contains("terminal")
+}
+
+/// Omarchy tags every terminal window, including its own TUI floats
+/// (`org.omarchy.*`, `TUI.*`), with the `terminal` tag. Dynamic tags carry a
+/// trailing `*`. Honouring the tag follows Omarchy's single definition of a
+/// terminal instead of a hard-coded class list.
+fn has_terminal_tag(window: &serde_json::Value) -> bool {
+    window
+        .get("tags")
+        .and_then(serde_json::Value::as_array)
+        .is_some_and(|tags| {
+            tags.iter()
+                .filter_map(serde_json::Value::as_str)
+                .any(|tag| tag.trim_end_matches('*') == "terminal")
+        })
+}
+
+fn focused_app_uses_terminal_paste() -> bool {
+    let desktop = std::env::var("XDG_CURRENT_DESKTOP").unwrap_or_default();
+    if !desktop.to_ascii_uppercase().contains("HYPRLAND") {
+        return false;
+    }
+    let Ok(output) = Command::new("hyprctl")
+        .args(["activewindow", "-j"])
+        .output()
+    else {
+        return false;
+    };
+    let Ok(window) = serde_json::from_slice::<serde_json::Value>(&output.stdout) else {
+        return false;
+    };
+    has_terminal_tag(&window)
+        || ["class", "initialClass"].iter().any(|key| {
+            window
+                .get(key)
+                .and_then(serde_json::Value::as_str)
+                .is_some_and(is_terminal_class)
+        })
+}
