+#[cfg(test)]
+mod tests {
+    use super::{has_terminal_tag, is_terminal_class};
+
+    #[test]
+    fn omarchy_terminal_tag_uses_terminal_paste_chord() {
+        let tagged = serde_json::json!({
+            "class": "org.omarchy.btop",
+            "tags": ["terminal*", "default-opacity"]
+        });
+        assert!(has_terminal_tag(&tagged));
+        let plain = serde_json::json!({ "class": "obsidian", "tags": ["default-opacity"] });
+        assert!(!has_terminal_tag(&plain));
+        let untagged = serde_json::json!({ "class": "kitty" });
+        assert!(!has_terminal_tag(&untagged));
+    }
+
+    #[test]
+    fn terminal_classes_use_terminal_paste_chord() {
+        for class in [
+            "dev.warp.Warp",
+            "kitty",
+            "org.gnome.Terminal",
+            "com.mitchellh.ghostty",
+        ] {
+            assert!(is_terminal_class(class), "{class}");
+        }
+    }
+
+    #[test]
+    fn regular_apps_keep_standard_paste_chord() {
+        for class in ["google-chrome", "Code", "obsidian"] {
+            assert!(!is_terminal_class(class), "{class}");
+        }
+    }
