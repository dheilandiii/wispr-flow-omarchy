# Single source of truth for every pinned input of the wispr-flow-omarchy build.
#
# Plain KEY='value' lines only: this file is sourced by bash (install.sh,
# scripts/*.sh, tests/smoke.sh) and mirrored by hand into packaging/aur/PKGBUILD,
# which tests/smoke.sh cross-checks. Update it with scripts/pin-latest.sh; do not
# edit the hashes by hand.

# Official Wispr Flow Windows client (Squirrel full nupkg). The Linux runtime is
# assembled from this exact file; its SHA-256 is verified before any patching.
WISPR_FLOW_VERSION='1.6.774'
WISPR_FLOW_NUPKG_SHA256='36a33ee649c834d617cc5c90c06d618ffda4062287ce8c064e4837448e4bdddc'
WISPR_FLOW_NUPKG_BASE_URL='https://dl.wisprflow.com/wispr-flow/win32/x64'
WISPR_FLOW_LATEST_URL='https://dl.wisprflow.ai/windows/latest'

# Electron runtime for Linux x86_64. Must match the Electron major the Windows
# client was built against (the nupkg carries its Electron version file); the
# SQLite native module below is compiled for this ABI.
ELECTRON_VERSION='42.3.0'
ELECTRON_LINUX_X64_SHA256='487a667ca6a734b958c16cff1df74d9d44d2c18a6cccdb4dd51f6301a356c420'

# wispr-flow-linux port: platform-gate patches, launcher-common.sh, doctor.sh.
PORT_REPO='https://github.com/wispr-flow-linux/wispr-flow-linux.git'
PORT_COMMIT='6fb43cd809f8319a9e05da4b4e7a2d3264c126ab'

# Clean-room Linux helper (Unlicense), built from the pinned commit plus the two
# patches in patches/helper/ by scripts/build-helper.sh. The binary in assets/
# must reproduce to this SHA-256.
HELPER_REPO='https://github.com/wispr-flow-linux/helper.git'
HELPER_COMMIT='fa93fcf31d9ee7a9591a8dce1852f815d1b0dec5'
HELPER_RUSTC_VERSION='1.96.0'
HELPER_SHA256='763496ebab14adb64108aa3c55392c68c9108b118b319b91656fc9e73e9f131d'

# Prebuilt node_sqlite3 for the Electron ABI above.
SQLITE_RELEASE_BASE_URL='https://github.com/wispr-flow-linux/native-modules/releases/download/native-v1'
SQLITE_NAME='node_sqlite3-x86_64.node'
SQLITE_SHA256='c9bd0419f77efb3b5d3a691fda04e265f740ad8dc195f0b56003cdeac92e9a34'
