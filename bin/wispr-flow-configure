#!/usr/bin/env bash
# wispr-flow-configure: per-user configuration for the Wispr Flow Omarchy port.
#
# Runs as the desktop user, never as root. The installer calls `bootstrap`, the
# launcher exposes the rest as `wispr-flow --<command>`, and the uninstaller uses
# `hyprland-rules off` / `autostart off` / `notetaker-audio off` to clean up.
#
# Hyprland integration modes (auto-detected, override with WISPR_FLOW_HYPR_MODE):
#   omarchy  ~/.config/hypr/hyprland.lua loads default.hypr.toggles, so managed
#            Lua files go in ~/.local/state/omarchy/toggles/hypr/. Omarchy loads
#            every *.lua there on each reload and omarchy-refresh-hyprland never
#            touches it, so the rules survive Omarchy config refreshes.
#   lua      plain Hyprland >= 0.55 Lua entry: a dofile() block is appended to
#            hyprland.lua and the rules live in ~/.config/hypr/wispr-flow.lua.
#   conf     classic hyprland.conf: a source= block plus wispr-flow.conf.

set -Eeuo pipefail

PROJECT='wispr-flow-omarchy'
LEGACY_PROJECT='whsprflow-arch'

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
config_dir="$config_home/Wispr Flow"
config_file="$config_dir/config.json"
port_state_dir="$state_home/$PROJECT"
notetaker_flag="$port_state_dir/notetaker-audio"
hypr_dir="$config_home/hypr"
hypr_main="$hypr_dir/hyprland.conf"
hypr_lua="$hypr_dir/hyprland.lua"
hypr_rules="$hypr_dir/wispr-flow.conf"
hypr_rules_lua="$hypr_dir/wispr-flow.lua"
hypr_autostart="$hypr_dir/autostart.conf"
omarchy_toggles_dir="$state_home/omarchy/toggles/hypr"
omarchy_rules_lua="$omarchy_toggles_dir/wispr-flow.lua"
omarchy_autostart_lua="$omarchy_toggles_dir/wispr-flow-autostart.lua"

rules_start="# >>> $PROJECT rules >>>"
rules_end="# <<< $PROJECT rules <<<"
lua_rules_start="-- >>> $PROJECT rules >>>"
lua_rules_end="-- <<< $PROJECT rules <<<"
autostart_start="# >>> $PROJECT autostart >>>"
autostart_end="# <<< $PROJECT autostart <<<"
lua_autostart_start="-- >>> $PROJECT autostart >>>"
lua_autostart_end="-- <<< $PROJECT autostart <<<"
legacy_rules_start="# >>> $LEGACY_PROJECT rules >>>"
legacy_rules_end="# <<< $LEGACY_PROJECT rules <<<"
legacy_lua_rules_start="-- >>> $LEGACY_PROJECT rules >>>"
legacy_lua_rules_end="-- <<< $LEGACY_PROJECT rules <<<"
legacy_autostart_start="# >>> $LEGACY_PROJECT autostart >>>"
legacy_autostart_end="# <<< $LEGACY_PROJECT autostart <<<"
legacy_lua_autostart_start="-- >>> $LEGACY_PROJECT autostart >>>"
legacy_lua_autostart_end="-- <<< $LEGACY_PROJECT autostart <<<"
rules_owner="# Managed by $PROJECT. Only Wispr Flow windows are affected."
rules_owner_lua="-- Managed by $PROJECT. Only Wispr Flow windows are affected."
legacy_rules_owner="# Managed by $LEGACY_PROJECT. Only the real Flow Hub is affected."
legacy_rules_owner_lua="-- Managed by $LEGACY_PROJECT. Only the real Flow Hub is affected."

notetaker_sink='wispr_notetaker_mix'
notetaker_description='Wispr Notetaker Mix (microphone + system audio)'
notetaker_mic_flag="$port_state_dir/notetaker-mic"
notetaker_mic_master="$port_state_dir/notetaker-mic-master"
notetaker_mic_selftest="$port_state_dir/notetaker-mic-selftest"
aec_mic='wispr_notetaker_mic'
aec_ref='wispr_notetaker_aec_ref'
aec_discard='wispr_aec_discard'
aec_description='Wispr Notetaker Mic (echo cancelled)'
aec_gate='wispr_notetaker_mic_gated'
aec_gate_description='Wispr Notetaker Mic (echo cancelled, gated)'
aec_gate_plugin='gate_1410'

die() {
	printf 'ERROR: %s\n' "$*" >&2
	exit 1
}

have() {
	command -v "$1" >/dev/null 2>&1
}

have_jq() {
	have jq || die "'jq' is required. Install the jq package."
}

# ---------------------------------------------------------------------------
# Wispr Flow config.json: Linux-safe push-to-talk shortcut and Flow Bar state.
# ---------------------------------------------------------------------------
rewrite_config() {
	local hide_bar="$1" reset_shortcut="${2:-false}"
	have_jq
	mkdir -p "$config_dir"
	umask 077
	local tmp
	tmp="$(mktemp "$config_dir/config.json.XXXXXX")"
	if [[ -f $config_file ]]; then
		jq --arg hide "$hide_bar" --arg reset "$reset_shortcut" '
			.prefs = (.prefs // {}) |
			.prefs.cache = (.prefs.cache // {}) |
			.prefs.user = (.prefs.user // {}) |
			(
				if $reset == "true" then "160+162"
				else (
					[.prefs.user.shortcuts // {} | to_entries[] |
						select(.value == "ptt" and (.key | test("^-?[0-9]+(\\+-?[0-9]+)+$")))] |
					.[0].key // "160+162"
				)
				end
			) as $pttKey |
			($pttKey | split("+") | map(tonumber)) as $pttCodes |
			.prefs.user.shortcuts = (
				((.prefs.user.shortcuts // {}) | with_entries(select(.value != "ptt")))
				+ {($pttKey): "ptt"}
			) |
			.prefs.cache.splitKeybinds = (
				((.prefs.cache.splitKeybinds // []) | map(select(.value != "ptt")))
				+ [{"shortcut": $pttCodes, "value": "ptt"}]
			) |
			if $hide == "true" then .prefs.user.hideFlowBarPermanently = true else . end
		' "$config_file" > "$tmp"
	else
		jq -n --arg hide "$hide_bar" '
			{
				prefs: {
					cache: {splitKeybinds: [{shortcut: [160, 162], value: "ptt"}]},
					user: {
						shortcuts: {"160+162": "ptt"},
						modifierShortcut: "164",
						hideFlowBarPermanently: ($hide == "true"),
						openAtLogin: false
					}
				}
			}
		' > "$tmp"
	fi
	mv "$tmp" "$config_file"
	chmod 0600 "$config_file"
}

ptt_shortcut() {
	jq -r '[.prefs.user.shortcuts // {} | to_entries[] | select(.value == "ptt")] | .[0].key // empty' "$config_file"
}

shortcut_label() {
	case "$1" in
		160+162|161+162|160+163|161+163) printf 'Ctrl+Shift' ;;
		91+162|91+163|92+162|92+163|162+91|163+91|162+92|163+92) printf 'Ctrl+Super' ;;
		*) printf 'key codes %s' "$1" ;;
	esac
}

# ---------------------------------------------------------------------------
# Hyprland integration.
# ---------------------------------------------------------------------------
hypr_entry_mode() {
	case "${WISPR_FLOW_HYPR_MODE:-}" in
		omarchy|lua|conf) printf '%s' "$WISPR_FLOW_HYPR_MODE"; return ;;
		'') ;;
		*) die "WISPR_FLOW_HYPR_MODE must be omarchy, lua or conf." ;;
	esac
	if [[ -f $hypr_lua ]] && grep -qF 'default.hypr.toggles' "$hypr_lua"; then
		printf 'omarchy'
	elif [[ -f $hypr_lua ]]; then
		printf 'lua'
	elif [[ -f $hypr_main ]]; then
		printf 'conf'
	else
		die "Neither $hypr_lua nor $hypr_main exists; is this a Hyprland session?"
	fi
}

# Exit 0 = exactly one well-formed block, 1 = none, 2 = malformed/duplicated.
managed_block_present() {
	local file="$1" start="$2" end="$3"
	[[ -f $file ]] || return 1
	awk -v start="$start" -v end="$end" '
		$0 == start {
			starts++
			if (inside || starts > 1) invalid = 1
			inside = 1
			next
		}
		$0 == end {
			ends++
			if (!inside || ends > 1) invalid = 1
			inside = 0
			next
		}
		END {
			if (invalid || inside || starts != ends) exit 2
			exit starts == 1 ? 0 : 1
		}
	' "$file" >/dev/null
}

remove_managed_block() {
	local file="$1" start="$2" end="$3"
	[[ -f $file ]] || return 0
	local rc target tmp
	if managed_block_present "$file" "$start" "$end"; then
		:
	else
		rc=$?
		((rc == 1)) && return 0
		die "The managed markers in $file are incomplete or duplicated; leaving the file untouched."
	fi
	target="$file"
	if [[ -L $file ]]; then
		target="$(readlink -f "$file")"
		[[ -f $target ]] || die "The symlink $file does not point at a regular file."
	fi
	tmp="$(mktemp "${target}.XXXXXX")"
	awk -v start="$start" -v end="$end" '
		$0 == start { skip = 1; next }
		$0 == end { skip = 0; next }
		!skip { print }
	' "$target" > "$tmp"
	chmod --reference="$target" "$tmp"
	mv "$tmp" "$target"
}

# Refuse to touch a file with one of our names that we did not write.
validate_rules_file() {
	local file="$1"
	shift
	[[ -e $file || -L $file ]] || return 0
	[[ ! -L $file ]] || die "$file is a symlink we do not own; leaving it alone."
	local first='' owner
	IFS= read -r first < "$file" || true
	for owner in "$@"; do
		[[ $first == "$owner" ]] && return 0
	done
	die "$file exists and was not written by $PROJECT; leaving it alone."
}

hyprland_reachable() {
	have hyprctl && hyprctl clients -j >/dev/null 2>&1
}

hyprland_config_errors() {
	hyprctl configerrors 2>/dev/null || true
}

reload_hyprland() {
	[[ ${WISPR_FLOW_SKIP_HYPR_RELOAD:-0} == 1 ]] && return 0
	hyprland_reachable || return 0
	hyprctl reload >/dev/null
}

write_lua_rules_file() {
	local path="$1" tmp
	mkdir -p "$(dirname "$path")"
	tmp="$(mktemp "${path}.XXXXXX")"
	cat > "$tmp" <<LUA
$rules_owner_lua
-- Regenerated by \`wispr-flow --hyprland-rules on\`; edits here are overwritten.
-- Uses only the hl API so the same file works with or without Omarchy helpers.
local class = "^(wispr-flow|Wispr Flow)$"

-- Every Wispr Flow surface is a utility window; none of them tile well.
hl.window_rule({ match = { class = class }, float = true })

-- Flow Hub (dictation history, settings, Notetaker): centered, remembers its size.
hl.window_rule({
	match = { class = class, title = "^(Flow )?Hub$" },
	float = true,
	center = true,
	size = { 1350, 850 },
	persistent_size = true,
	no_shortcuts_inhibit = true,
})

-- Dictation status pill: shown while recording, must never steal focus.
hl.window_rule({
	match = { class = class, title = "^(Status|Flow Status Indicator)$" },
	float = true,
	no_focus = true,
	no_follow_mouse = true,
	no_shortcuts_inhibit = true,
	border_size = 0,
})

-- Notetaker popups (meeting reminders, the recorder pill): keep them visible on
-- every workspace for the duration of a meeting.
hl.window_rule({
	match = { class = class, title = "([Rr]eminder|[Rr]ecorder|[Mm]eeting|[Nn]otetaker)" },
	float = true,
	pin = true,
})
LUA
	mv "$tmp" "$path"
	chmod 0644 "$path"
}

write_conf_rules_file() {
	local tmp
	tmp="$(mktemp "${hypr_rules}.XXXXXX")"
	cat > "$tmp" <<CONF
$rules_owner
windowrule = float on, match:class ^(wispr-flow|Wispr Flow)$
windowrule = center on, match:class ^(wispr-flow|Wispr Flow)$, match:title ^(Flow )?Hub$
windowrule = size 1350 850, match:class ^(wispr-flow|Wispr Flow)$, match:title ^(Flow )?Hub$
windowrule = persistent_size on, match:class ^(wispr-flow|Wispr Flow)$, match:title ^(Flow )?Hub$
windowrule = no_shortcuts_inhibit on, match:class ^(wispr-flow|Wispr Flow)$, match:title ^(Flow )?Hub$
windowrule = no_focus on, match:class ^(wispr-flow|Wispr Flow)$, match:title ^(Status|Flow Status Indicator)$
windowrule = no_follow_mouse on, match:class ^(wispr-flow|Wispr Flow)$, match:title ^(Status|Flow Status Indicator)$
windowrule = no_shortcuts_inhibit on, match:class ^(wispr-flow|Wispr Flow)$, match:title ^(Status|Flow Status Indicator)$
windowrule = border_size 0, match:class ^(wispr-flow|Wispr Flow)$, match:title ^(Status|Flow Status Indicator)$
windowrule = pin on, match:class ^(wispr-flow|Wispr Flow)$, match:title ([Rr]eminder|[Rr]ecorder|[Mm]eeting|[Nn]otetaker)
CONF
	mv "$tmp" "$hypr_rules"
	chmod 0644 "$hypr_rules"
}

write_lua_autostart_file() {
	local path="$1" tmp
	mkdir -p "$(dirname "$path")"
	tmp="$(mktemp "${path}.XXXXXX")"
	cat > "$tmp" <<LUA
$rules_owner_lua
-- Start Wispr Flow in the background with the Hyprland session (uwsm-managed).
hl.on("hyprland.start", function()
	hl.exec_cmd("uwsm-app -- wispr-flow --background")
end)
LUA
	mv "$tmp" "$path"
	chmod 0644 "$path"
}

# Remove every rules artifact this project or the legacy upstream may have left.
remove_all_rule_artifacts() {
	remove_managed_block "$hypr_main" "$rules_start" "$rules_end"
	remove_managed_block "$hypr_main" "$legacy_rules_start" "$legacy_rules_end"
	remove_managed_block "$hypr_lua" "$lua_rules_start" "$lua_rules_end"
	remove_managed_block "$hypr_lua" "$legacy_lua_rules_start" "$legacy_lua_rules_end"
	rm -f "$hypr_rules" "$hypr_rules_lua" "$omarchy_rules_lua"
}

remove_all_autostart_artifacts() {
	remove_managed_block "$hypr_autostart" "$autostart_start" "$autostart_end"
	remove_managed_block "$hypr_autostart" "$legacy_autostart_start" "$legacy_autostart_end"
	remove_managed_block "$hypr_lua" "$lua_autostart_start" "$lua_autostart_end"
	remove_managed_block "$hypr_lua" "$legacy_lua_autostart_start" "$legacy_lua_autostart_end"
	rm -f "$omarchy_autostart_lua"
}

validate_all_rules_files() {
	validate_rules_file "$hypr_rules" "$rules_owner" "$legacy_rules_owner"
	validate_rules_file "$hypr_rules_lua" "$rules_owner_lua" "$legacy_rules_owner_lua"
	validate_rules_file "$omarchy_rules_lua" "$rules_owner_lua"
	validate_rules_file "$omarchy_autostart_lua" "$rules_owner_lua"
}

# Reload and make sure we did not introduce a config error. Errors that were
# already present before we touched anything are reported but not blamed on us.
reload_and_verify() {
	local before="$1"
	[[ ${WISPR_FLOW_SKIP_HYPR_RELOAD:-0} == 1 ]] && return 0
	hyprland_reachable || return 0
	hyprctl reload >/dev/null
	local after
	after="$(hyprland_config_errors)"
	[[ $after == "$before" ]] && return 0
	printf 'Hyprland reported configuration errors after the change:\n%s\n' "$after" >&2
	return 1
}

configure_hyprland_rules() {
	local mode before
	case "${1:-}" in
		on)
			mode="$(hypr_entry_mode)"
			mkdir -p "$hypr_dir"
			validate_all_rules_files
			before=''
			[[ ${WISPR_FLOW_SKIP_HYPR_RELOAD:-0} == 1 ]] || ! hyprland_reachable || before="$(hyprland_config_errors)"
			remove_all_rule_artifacts
			case "$mode" in
				omarchy)
					write_lua_rules_file "$omarchy_rules_lua"
					;;
				lua)
					write_lua_rules_file "$hypr_rules_lua"
					cat >> "$hypr_lua" <<BLOCK

$lua_rules_start
dofile("$hypr_rules_lua")
$lua_rules_end
BLOCK
					;;
				conf)
					write_conf_rules_file
					cat >> "$hypr_main" <<BLOCK

$rules_start
source = $hypr_rules
$rules_end
BLOCK
					;;
			esac
			if ! reload_and_verify "$before"; then
				remove_all_rule_artifacts
				reload_hyprland
				die 'The Wispr Flow window rules were rolled back; Hyprland rejected them.'
			fi
			case "$mode" in
				omarchy) printf 'Hyprland rules installed for Omarchy: %s\n' "$omarchy_rules_lua" ;;
				lua) printf 'Hyprland rules installed (Lua entry): %s\n' "$hypr_rules_lua" ;;
				conf) printf 'Hyprland rules installed (conf entry): %s\n' "$hypr_rules" ;;
			esac
			;;
		off)
			validate_all_rules_files
			remove_all_rule_artifacts
			reload_hyprland
			printf 'Hyprland rules removed.\n'
			;;
		check)
			mode="$(hypr_entry_mode)"
			validate_all_rules_files
			case "$mode" in
				omarchy) [[ -f $omarchy_rules_lua ]] ;;
				lua) [[ -f $hypr_rules_lua ]] && managed_block_present "$hypr_lua" "$lua_rules_start" "$lua_rules_end" ;;
				conf) [[ -f $hypr_rules ]] && managed_block_present "$hypr_main" "$rules_start" "$rules_end" ;;
			esac
			;;
		*) die 'Usage: wispr-flow --hyprland-rules on|off|check' ;;
	esac
}

configure_autostart() {
	local rc mode
	case "${1:-}" in
		on)
			have uwsm-app || die "'uwsm-app' is not installed; Omarchy manages sessions with uwsm."
			mode="$(hypr_entry_mode)"
			mkdir -p "$hypr_dir"
			validate_rules_file "$omarchy_autostart_lua" "$rules_owner_lua"
			remove_all_autostart_artifacts
			case "$mode" in
				omarchy)
					write_lua_autostart_file "$omarchy_autostart_lua"
					printf 'Autostart enabled: %s\n' "$omarchy_autostart_lua"
					;;
				lua)
					cat >> "$hypr_lua" <<BLOCK

$lua_autostart_start
hl.on("hyprland.start", function()
	hl.exec_cmd("uwsm-app -- wispr-flow --background")
end)
$lua_autostart_end
BLOCK
					printf 'Autostart enabled in %s\n' "$hypr_lua"
					;;
				conf)
					touch "$hypr_autostart"
					cat >> "$hypr_autostart" <<BLOCK

$autostart_start
exec-once = uwsm-app -- wispr-flow --background
$autostart_end
BLOCK
					printf 'Autostart enabled in %s\n' "$hypr_autostart"
					;;
			esac
			;;
		off)
			validate_rules_file "$omarchy_autostart_lua" "$rules_owner_lua"
			remove_all_autostart_artifacts
			printf 'Autostart disabled.\n'
			;;
		status)
			local present=1
			[[ -f $omarchy_autostart_lua ]] && present=0
			rc=0; managed_block_present "$hypr_autostart" "$autostart_start" "$autostart_end" || rc=$?
			((rc == 2)) && die "The managed markers in $hypr_autostart are incomplete or duplicated."
			((rc == 0)) && present=0
			rc=0; managed_block_present "$hypr_lua" "$lua_autostart_start" "$lua_autostart_end" || rc=$?
			((rc == 2)) && die "The managed markers in $hypr_lua are incomplete or duplicated."
			((rc == 0)) && present=0
			if ((present == 0)); then
				printf 'Autostart: enabled\n'
			else
				printf 'Autostart: disabled\n'
				return 1
			fi
			;;
		*) die 'Usage: wispr-flow --autostart on|off|status' ;;
	esac
}

# ---------------------------------------------------------------------------
# Notetaker audio: a PipeWire virtual source that mixes the default microphone
# with the monitor of the default output, so Wispr Flow's Notetaker can record
# both sides of a meeting. Select "Wispr Notetaker Mix" as the microphone in
# Flow when recording a meeting; pick the real microphone again for dictation.
# ---------------------------------------------------------------------------
pulse_ready() {
	have pactl && pactl info >/dev/null 2>&1
}

# pactl load-module splits every module argument on ASCII whitespace, quotes
# included, so a description with spaces arrives as its first word ("Wispr").
# pactl 17 has no update-*-proplist command to fix it afterwards. Non-breaking
# spaces pass through the split and render as spaces in device pickers.
module_label() {
	local nbsp=$'\xc2\xa0'
	printf '%s' "${1// /$nbsp}"
}

notetaker_module_ids() {
	pactl list short modules 2>/dev/null | awk -v sink="$notetaker_sink" '
		$2 == "module-null-sink" && index($0, "sink_name=" sink) { print $1; next }
		$2 == "module-loopback" && index($0, "sink=" sink) { print $1 }
	'
}

notetaker_sink_present() {
	pactl list short sinks 2>/dev/null | awk '{ print $2 }' | grep -qx "$notetaker_sink"
}

# Both Notetaker audio paths read the monitor of the default output: Chromium's
# loopback records "@DEFAULT_SINK@".monitor and the mix loops @DEFAULT_MONITOR@
# into its sink. The monitor has a volume of its own (pipewire-pulse maps it to
# the sink node's monitorVolumes) that no playback control shows; a mixer that
# lists monitors as recording devices can turn it down and WirePlumber does not
# restore it, so the recorder gets a live but silent track.
default_monitor_source() {
	local sink
	sink="$(pactl get-default-sink 2>/dev/null)" || return 1
	[[ -n $sink ]] || return 1
	printf '%s.monitor\n' "$sink"
}

monitor_volume_percent() {
	# First channel of `pactl get-source-volume`, e.g.
	# "Volume: front-left: 5140 /   8% / -66.33 dB, ..." -> 8
	local line
	line="$(pactl get-source-volume "$1" 2>/dev/null | head -1)" || return 1
	[[ $line =~ /[[:space:]]*([0-9]+)% ]] || return 1
	printf '%s\n' "${BASH_REMATCH[1]}"
}

monitor_is_muted() {
	pactl get-source-mute "$1" 2>/dev/null | grep -q 'Mute: yes'
}

# Prints one line; exit 0 at 100% and unmuted, 1 when quiet or muted, 2 when
# the volume cannot be read.
system_audio_check() {
	local monitor percent
	pulse_ready || { printf "PipeWire's PulseAudio server is not reachable.\n" >&2; return 2; }
	monitor="$(default_monitor_source)" || { printf 'No default output.\n' >&2; return 2; }
	percent="$(monitor_volume_percent "$monitor")" || { printf 'Could not read the volume of %s.\n' "$monitor" >&2; return 2; }
	if monitor_is_muted "$monitor"; then
		printf 'Default output monitor %s is muted: Notetaker hears no system audio\n' "$monitor"
		return 1
	fi
	if ((percent >= 100)); then
		printf 'Default output monitor %s at %s%%\n' "$monitor" "$percent"
		return 0
	fi
	printf 'Default output monitor %s at %s%%: Notetaker hears system audio attenuated or not at all\n' "$monitor" "$percent"
	return 1
}

system_audio_fix() {
	local monitor
	pulse_ready || die "PipeWire's PulseAudio server is not reachable (pactl info failed). Is pipewire-pulse running?"
	monitor="$(default_monitor_source)" || die 'No default output to fix.'
	pactl set-source-volume "$monitor" 100% || die "Could not set the volume of $monitor."
	pactl set-source-mute "$monitor" 0 2>/dev/null || true
	printf 'Default output monitor %s set to 100%% and unmuted (playback volume untouched).\n' "$monitor"
}

# ---------------------------------------------------------------------------
# Echo-cancelled microphone: the laptop microphone hears whatever the speakers
# play, so a meeting recorded with Chromium loopback + microphone transcribes
# the other side twice ("Them" from the loopback, "You" from the mic). macOS and
# Windows cancel that system-wide in the OS; Linux does not, and Chromium's own
# canceller only knows the audio Chromium itself plays. PipeWire's echo-cancel
# module (WebRTC engine) provides the equivalent: it takes the real microphone
# and a reference, and exposes a cancelled source. The reference is the default
# output's monitor, routed through a loopback into the module's sink; what the
# module would play back goes to a null sink so nothing is heard twice.
#
# The reference has to reach the canceller shortly before the echo reaches the
# microphone. loopback latency_msec sets how much reference queues ahead of the
# capture. On the XPS 9320 (8 x 1024-frame ALSA periods, 170 ms of output
# buffering) the echo arrived ~206 ms after the monitor carried it and
# latency_msec=170 cancelled 26-31 dB of it, while 140 and 200 cancelled almost
# nothing, so the default is the default output's ALSA buffer length.
# WISPR_FLOW_AEC_DELAY_MS overrides it.
# ---------------------------------------------------------------------------
aec_module_ids() {
	pactl list short modules 2>/dev/null | awk -v mic="$aec_mic" -v ref="$aec_ref" -v dis="$aec_discard" -v gate="$aec_gate" '
		$2 == "module-null-sink" && index($0, "sink_name=" dis) { print $1; next }
		$2 == "module-echo-cancel" && index($0, "source_name=" mic) { print $1; next }
		$2 == "module-loopback" && index($0, "sink=" ref) { print $1; next }
		$2 == "module-ladspa-source" && index($0, "source_name=" gate) { print $1 }
	'
}

aec_source_present() {
	pactl list short sources 2>/dev/null | awk '{ print $2 }' | grep -qx "$aec_mic"
}

aec_gate_present() {
	pactl list short sources 2>/dev/null | awk '{ print $2 }' | grep -qx "$aec_gate"
}

# Gate stage: the canceller leaves a residual of the speakers (about -60 dB
# peak, -85 dB mean here) that the transcriber still decodes, because
# Chromium's gain control and the speech model normalise level. A LADSPA gate
# (swh-plugins gate_1410) after the canceller turns anything below speaking
# level into real silence. Its threshold compares against the signal's average
# level, not its peaks: at -55 dB it blocks input averaging -70 dB and passes
# input averaging -55 dB and louder (a voice at the built-in microphone
# averages -45 to -25 dB). WISPR_FLOW_MIC_GATE_DB overrides, WISPR_FLOW_MIC_GATE=0
# skips the stage.
aec_gate_plugin_path() {
	local dir IFS=':'
	for dir in ${LADSPA_PATH:-/usr/lib/ladspa:/usr/local/lib/ladspa:/usr/lib64/ladspa}; do
		[[ -f $dir/$aec_gate_plugin.so ]] && { printf '%s\n' "$dir/$aec_gate_plugin.so"; return 0; }
	done
	return 1
}

aec_gate_wanted() {
	[[ ${WISPR_FLOW_MIC_GATE:-1} == 1 ]] && aec_gate_plugin_path >/dev/null
}

aec_gate_db() {
	local db="${WISPR_FLOW_MIC_GATE_DB:--55}"
	[[ $db =~ ^-?[0-9]+$ ]] && ((db >= -70 && db <= 0)) || db=-55
	printf '%s\n' "$db"
}

# What Wispr Flow should record from: the gated source when the gate is up.
aec_output_source() {
	if aec_gate_present; then printf '%s\n' "$aec_gate"; else printf '%s\n' "$aec_mic"; fi
}

aec_gate_on() {
	local quiet="${1:-false}"
	aec_gate_wanted || return 0
	aec_gate_present && return 0
	# gate_1410 ports: LF key (Hz), HF key (Hz), threshold (dB), attack (ms),
	# hold (ms), decay (ms), range (dB), output select (0 = gate).
	if pactl load-module module-ladspa-source "source_name=$aec_gate" "master=$aec_mic" \
			"plugin=$aec_gate_plugin" label=gate "control=60,8000,$(aec_gate_db),5,250,300,-90,0" \
			"source_properties=device.description=$(module_label "$aec_gate_description")" >/dev/null; then
		$quiet || printf 'Gate added after the canceller: %s (threshold %s dB).\n' "$aec_gate" "$(aec_gate_db)"
	else
		$quiet || printf 'WARNING: could not load the LADSPA gate; recording from the ungated canceller.\n' >&2
	fi
}

# The real microphone a loaded canceller was built on (its source_master).
aec_master_from_modules() {
	pactl list short modules 2>/dev/null | awk -v mic="$aec_mic" '
		$2 == "module-echo-cancel" && index($0, "source_name=" mic) {
			for (i = 3; i <= NF; i++) if ($i ~ /^source_master=/) { sub(/^source_master=/, "", $i); print $i; exit }
		}
	'
}

aec_delay_ms() {
	if [[ ${WISPR_FLOW_AEC_DELAY_MS:-} =~ ^[0-9]+$ ]]; then
		printf '%s\n' "$WISPR_FLOW_AEC_DELAY_MS"
		return 0
	fi
	local sink ms=''
	sink="$(pactl get-default-sink 2>/dev/null)" || sink=''
	if [[ -n $sink ]] && have pw-dump && have jq; then
		ms="$(pw-dump 2>/dev/null | jq -r --arg n "$sink" '
			[.[] | select(.type == "PipeWire:Interface:Node" and .info.props["node.name"] == $n)
			| .info.props
			| select(.["api.alsa.period-size"] != null and .["api.alsa.period-num"] != null)
			| ((.["api.alsa.period-size"] | tonumber) * (.["api.alsa.period-num"] | tonumber) * 1000
			   / ((.["audio.rate"] // 48000) | tonumber) | floor)] | first // empty' 2>/dev/null)" || ms=''
		if [[ $ms =~ ^[0-9]+$ ]] && ((ms >= 20 && ms <= 500)); then
			printf '%s\n' "$ms"
			return 0
		fi
	fi
	printf '170\n'
}

# The canceller's alignment is set when its reference stream starts and varies
# between starts: with the same latency_msec, fresh starts cancelled 28 dB or
# 2 dB (see NOTETAKER.md). So `on` plays a 4 s speech-like test signal through
# the speakers, compares what the real microphone and the cancelled source pick
# up, and restarts the reference until the cancelled source is at least 12 dB
# quieter. Exit 0 aligned, 1 not aligned, 2 could not test.
aec_selftest() {
	local master="$1" tmpd sig raw aec result raw_db aec_db
	have paplay && have parecord && have python3 || return 2
	tmpd="$(mktemp -d "${TMPDIR:-/tmp}/wispr-aec.XXXXXX")" || return 2
	sig="$tmpd/signal.wav"; raw="$tmpd/raw.wav"; aec="$tmpd/aec.wav"
	python3 - "$sig" <<'PY' || { rm -rf "$tmpd"; return 2; }
import math, struct, sys, wave
sr, dur = 48000, 4.0
out = bytearray()
harm = ((1, .25), (2, .2), (3, .18), (4, .15), (5, .12), (6, .1), (7, .08), (8, .06))
for i in range(int(sr * dur)):
    t = i / sr
    f0 = 110 + 35 * math.sin(2 * math.pi * 0.6 * t) + 20 * math.sin(2 * math.pi * 1.7 * t)
    g = 1.0 if (t % 0.45) < 0.3 else 0.0
    s = sum(a * math.sin(2 * math.pi * k * f0 * t) for k, a in harm) * g
    v = int(max(-1.0, min(1.0, s)) * 32767)
    out += struct.pack('<hh', v, v)
w = wave.open(sys.argv[1], 'wb'); w.setnchannels(2); w.setsampwidth(2); w.setframerate(sr); w.writeframes(bytes(out)); w.close()
PY
	timeout 5 parecord --device="$master" --file-format=wav "$raw" 2>/dev/null &
	local r1=$!
	timeout 5 parecord --device="$aec_mic" --file-format=wav "$aec" 2>/dev/null &
	local r2=$!
	sleep 0.5
	paplay --volume=65536 "$sig" >/dev/null 2>&1 || true
	wait "$r1" "$r2" 2>/dev/null || true
	result="$(python3 - "$raw" "$aec" <<'PY'
import math, struct, sys, wave
def level(path):
    try:
        w = wave.open(path, 'rb')
    except Exception:
        return None
    n, width = w.getnframes(), w.getsampwidth()
    data = w.readframes(n); w.close()
    if width != 2 or n == 0:
        return None
    samples = struct.unpack('<%dh' % (len(data) // 2), data)
    tail = samples[int(len(samples) * 0.4):]          # skip convergence
    if not tail:
        return None
    rms = math.sqrt(sum(s * s for s in tail) / len(tail))
    return 20 * math.log10(max(rms, 1) / 32768.0)
a, b = level(sys.argv[1]), level(sys.argv[2])
print('nan nan' if a is None or b is None else '%.1f %.1f' % (a, b))
PY
)"
	rm -rf "$tmpd"
	read -r raw_db aec_db <<< "$result"
	[[ $raw_db != nan && $aec_db != nan ]] || return 2
	# The microphone must have heard the speakers at all.
	awk -v r="$raw_db" 'BEGIN { exit !(r > -70) }' || return 2
	printf '%s %s\n' "$raw_db" "$aec_db" > "$port_state_dir/.selftest-last"
	awk -v r="$raw_db" -v a="$aec_db" 'BEGIN { exit !(r - a >= 12) }'
}

aec_reference_restart() {
	local id delay="$1"
	while read -r id; do
		[[ -n $id ]] && pactl unload-module "$id" 2>/dev/null || true
	done < <(pactl list short modules 2>/dev/null | awk -v ref="$aec_ref" '$2 == "module-loopback" && index($0, "sink=" ref) { print $1 }')
	pactl load-module module-loopback "source=@DEFAULT_MONITOR@" "sink=$aec_ref" "latency_msec=$delay" sink_dont_move=true >/dev/null
	sleep 1
}

aec_align() {
	local quiet="$1" master="$2" delay="$3" attempt rc last
	mkdir -p "$port_state_dir"
	if [[ ${WISPR_FLOW_AEC_VERIFY:-1} != 1 ]]; then
		printf 'skipped (WISPR_FLOW_AEC_VERIFY=0)\n' > "$notetaker_mic_selftest"
		$quiet || printf 'Canceller self-test skipped (WISPR_FLOW_AEC_VERIFY=0).\n'
		return 0
	fi
	for attempt in 1 2 3 4; do
		aec_selftest "$master"; rc=$?
		last="$(cat "$port_state_dir/.selftest-last" 2>/dev/null || printf '? ?')"
		if ((rc == 0)); then
			# shellcheck disable=SC2086
			printf 'aligned: microphone %s dB, cancelled %s dB (attempt %s, %s)\n' $last "$attempt" "$(date +%H:%M)" > "$notetaker_mic_selftest"
			# shellcheck disable=SC2086
			$quiet || printf 'Canceller aligned: test signal at the microphone %s dB, after cancellation %s dB (attempt %s).\n' $last "$attempt"
			return 0
		fi
		if ((rc == 2)); then
			printf 'not verified: speakers silent or paplay/parecord/python3 missing (%s)\n' "$(date +%H:%M)" > "$notetaker_mic_selftest"
			$quiet || printf 'WARNING: could not verify the canceller (speakers silent or paplay/parecord/python3 missing); it may or may not be aligned. Turn the volume up and run wispr-flow --notetaker-mic on again.\n' >&2
			return 0
		fi
		if ((attempt < 4)); then
			# shellcheck disable=SC2086
			$quiet || printf 'Canceller not aligned (microphone %s dB, cancelled %s dB); restarting its reference (attempt %s of 4).\n' $last "$attempt"
			aec_reference_restart "$delay"
		fi
	done
	# shellcheck disable=SC2086
	printf 'NOT aligned after 4 attempts: microphone %s dB, cancelled %s dB (%s)\n' $last "$(date +%H:%M)" > "$notetaker_mic_selftest"
	# shellcheck disable=SC2086
	$quiet || printf 'WARNING: the canceller did not align in 4 attempts (microphone %s dB, cancelled %s dB). Run wispr-flow --notetaker-mic on again, or try WISPR_FLOW_AEC_DELAY_MS=130 or 230.\n' $last >&2
	return 1
}

notetaker_mic_on() {
	local quiet="${1:-false}" master delay
	pulse_ready || die "PipeWire's PulseAudio server is not reachable (pactl info failed). Is pipewire-pulse running?"
	master="$(pactl get-default-source 2>/dev/null)" || master=''
	if [[ -z $master || $master == "$aec_mic" || $master == "$aec_gate" ]]; then
		# A cancelled source is already the default: take the real microphone
		# from the remembered state, or from the loaded canceller itself.
		if [[ -s $notetaker_mic_master ]]; then
			master="$(< "$notetaker_mic_master")"
		else
			master="$(aec_master_from_modules)"
		fi
	fi
	[[ -n $master && $master != "$aec_mic" && $master != "$aec_gate" ]] || die 'Could not determine the real microphone; select a default input first.'
	delay="$(aec_delay_ms)"
	if aec_source_present; then
		$quiet || printf 'Echo-cancelled microphone already present: %s\n' "$aec_mic"
		$quiet || aec_align "$quiet" "$master" "$delay" || true
		aec_gate_on "$quiet"
	else
		pactl load-module module-null-sink "sink_name=$aec_discard" \
			"sink_properties=device.description=$(module_label 'Wispr Notetaker AEC discard (internal)')" >/dev/null \
			|| die 'Could not create the echo canceller discard sink.'
		pactl load-module module-echo-cancel "source_master=$master" "sink_master=$aec_discard" \
			"source_name=$aec_mic" "sink_name=$aec_ref" aec_method=webrtc \
			"source_properties=device.description=$(module_label "$aec_description")" \
			"sink_properties=device.description=$(module_label 'Wispr Notetaker AEC reference (internal)')" >/dev/null \
			|| { notetaker_mic_off true; die "Could not load PipeWire's echo-cancel module (pipewire-audio with the WebRTC plugin is required)."; }
		pactl load-module module-loopback "source=@DEFAULT_MONITOR@" "sink=$aec_ref" \
			"latency_msec=$delay" sink_dont_move=true >/dev/null \
			|| { notetaker_mic_off true; die 'Could not route the output monitor into the echo canceller.'; }
		$quiet || printf 'Echo-cancelled microphone created: %s (cancels %s, reference delay %s ms).\n' "$aec_mic" "$master" "$delay"
		if $quiet; then
			mkdir -p "$port_state_dir"
			printf 'not verified: recreated at launch (%s); run wispr-flow --notetaker-mic on to verify\n' "$(date +%H:%M)" > "$notetaker_mic_selftest"
		else
			aec_align "$quiet" "$master" "$delay" || true
		fi
		aec_gate_on "$quiet"
	fi
	mkdir -p "$port_state_dir"
	printf '%s\n' "$master" > "$notetaker_mic_master"
	printf 'on\n' > "$notetaker_mic_flag"
	local output label
	output="$(aec_output_source)"
	label="$aec_description"; [[ $output == "$aec_gate" ]] && label="$aec_gate_description"
	if [[ $(pactl get-default-source 2>/dev/null) != "$output" ]]; then
		if pactl set-default-source "$output" >/dev/null 2>&1; then
			$quiet || printf 'Default input is now "%s"; Wispr Flow follows it for dictation and Notetaker. wispr-flow --notetaker-mic off restores %s.\n' "$label" "$master"
		else
			$quiet || printf 'WARNING: could not make %s the default input; select "%s" as the microphone in Wispr Flow.\n' "$output" "$label" >&2
		fi
	fi
	if ! $quiet; then
		local monitor_state
		if ! monitor_state="$(system_audio_check 2>/dev/null)"; then
			printf 'WARNING: %s. Run wispr-flow --system-audio fix.\n' \
				"${monitor_state:-the default output monitor volume could not be read}" >&2
		fi
	fi
}

notetaker_mic_off() {
	local quiet="${1:-false}" id count=0 master=''
	[[ -s $notetaker_mic_master ]] && master="$(< "$notetaker_mic_master")"
	if pulse_ready; then
		local current
		current="$(pactl get-default-source 2>/dev/null)" || current=''
		if [[ -n $master && ($current == "$aec_mic" || $current == "$aec_gate") ]]; then
			pactl set-default-source "$master" >/dev/null 2>&1 || true
		fi
		while read -r id; do
			[[ -n $id ]] || continue
			pactl unload-module "$id" 2>/dev/null && count=$((count + 1))
		done < <(aec_module_ids | sort -rn)
	fi
	rm -f "$notetaker_mic_flag" "$notetaker_mic_master" "$notetaker_mic_selftest" "$port_state_dir/.selftest-last"
	$quiet || printf 'Echo-cancelled microphone removed (%s module(s) unloaded%s).\n' "$count" "${master:+; default input back to $master}"
}

notetaker_mic_status() {
	local flag='off'
	[[ -f $notetaker_mic_flag ]] && flag='on'
	printf 'Echo-cancelled microphone preference: %s\n' "$flag"
	if ! pulse_ready; then
		printf 'PipeWire PulseAudio server: not reachable\n'
		return 1
	fi
	printf 'Reference delay: %s ms%s\n' "$(aec_delay_ms)" "${WISPR_FLOW_AEC_DELAY_MS:+ (WISPR_FLOW_AEC_DELAY_MS)}"
	if [[ ${WISPR_FLOW_MIC_GATE:-1} != 1 ]]; then
		printf 'Gate: off (WISPR_FLOW_MIC_GATE=0)\n'
	elif ! aec_gate_plugin_path >/dev/null; then
		printf 'Gate: unavailable (LADSPA %s not found; install swh-plugins)\n' "$aec_gate_plugin"
	elif aec_gate_present; then
		printf 'Gate: on (threshold %s dB, source %s)\n' "$(aec_gate_db)" "$aec_gate"
	else
		printf 'Gate: available, not loaded (threshold %s dB)\n' "$(aec_gate_db)"
	fi
	if aec_source_present; then
		printf 'Source %s: present (%s module(s)), cancelling %s\nSelf-test: %s\nDefault input: %s\n' \
			"$aec_mic" "$(aec_module_ids | wc -l | tr -d ' ')" \
			"$(cat "$notetaker_mic_master" 2>/dev/null || printf '?')" \
			"$(cat "$notetaker_mic_selftest" 2>/dev/null || printf 'none')" \
			"$(pactl get-default-source 2>/dev/null)"
		return 0
	fi
	printf 'Source %s: absent\n' "$aec_mic"
	[[ $flag == on ]] && return 1
	return 0
}

configure_notetaker_mic() {
	case "${1:-}" in
		on) notetaker_mic_on false ;;
		off) notetaker_mic_off false ;;
		status) notetaker_mic_status ;;
		ensure)
			[[ -f $notetaker_mic_flag ]] || return 0
			pulse_ready || return 0
			if aec_source_present && { ! aec_gate_wanted || aec_gate_present; }; then return 0; fi
			notetaker_mic_on true
			;;
		*) die 'Usage: wispr-flow --notetaker-mic on|off|status' ;;
	esac
}

guard_log() {
	printf '%s system-audio guard: %s\n' "$(date +%T)" "$*"
}

# Restore the monitor when it is quiet or muted; silent when it is fine or
# when PipeWire cannot be read.
system_audio_restore() {
	local state monitor
	if state="$(system_audio_check 2>/dev/null)"; then
		return 0
	fi
	[[ -n $state ]] || return 0
	monitor="$(default_monitor_source)" || return 0
	pactl set-source-volume "$monitor" 100% 2>/dev/null || return 0
	pactl set-source-mute "$monitor" 0 2>/dev/null || true
	guard_log "restored to 100%: $state"
}

# `system-audio guard [PID]`: keep the default output's monitor at 100% while
# Wispr Flow runs. The recorder's loopback capture turns the monitor source
# down to about 8% (20 of Chromium's 255 input levels) the moment it acquires
# the track, which leaves it a live but silent stream. The launcher starts one
# guard per session (flock keeps it single); it follows PulseAudio events,
# restores the monitor whenever it drops, and exits with the given PID.
system_audio_guard() {
	local electron_pid="${1:-}" lock fifo line rc
	pulse_ready || return 0
	have flock || { guard_log 'flock missing; not guarding'; return 0; }
	mkdir -p "$port_state_dir"
	lock="$port_state_dir/system-audio-guard.lock"
	exec 9> "$lock"
	flock -n 9 || return 0
	fifo="$(mktemp -u "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/wispr-flow-guard.XXXXXX")"
	mkfifo -m 0600 "$fifo" || return 0
	pactl subscribe > "$fifo" 2>/dev/null &
	guard_sub_pid=$!
	exec 8< "$fifo"
	rm -f "$fifo"
	# Global on purpose: the EXIT trap fires after this function has returned.
	trap 'kill "${guard_sub_pid:-}" 2>/dev/null || true' EXIT
	guard_log "started (electron pid ${electron_pid:-none})"
	system_audio_restore
	while :; do
		rc=0
		read -r -t 5 -u 8 line || rc=$?
		if ((rc == 0)); then
			case "$line" in
				*"'change' on sink"*|*"'change' on source"*|*"'new' on source-output"*|*"'change' on server"*)
					system_audio_restore ;;
			esac
		elif ((rc < 128)); then
			guard_log 'pactl subscribe ended; stopping'
			break
		fi
		if [[ -n $electron_pid ]] && ! kill -0 "$electron_pid" 2>/dev/null; then
			guard_log 'Wispr Flow exited; stopping'
			break
		fi
	done
}

configure_system_audio() {
	case "${1:-}" in
		check) system_audio_check ;;
		fix) system_audio_fix ;;
		guard) system_audio_guard "${2:-}" ;;
		*) die 'Usage: wispr-flow --system-audio check|fix' ;;
	esac
}

notetaker_audio_on() {
	local quiet="${1:-false}"
	pulse_ready || die "PipeWire's PulseAudio server is not reachable (pactl info failed). Is pipewire-pulse running?"
	if [[ $(pactl get-default-sink 2>/dev/null) == "$notetaker_sink" ]]; then
		die "The default output is $notetaker_sink itself; select a real output first to avoid a feedback loop."
	fi
	if notetaker_sink_present; then
		$quiet || printf 'Notetaker audio mix already present: %s\n' "$notetaker_sink"
	else
		pactl load-module module-null-sink "sink_name=$notetaker_sink" \
			"sink_properties=device.description=$(module_label "$notetaker_description")" >/dev/null \
			|| die 'Could not create the Notetaker mix sink.'
		pactl load-module module-loopback "source=@DEFAULT_SOURCE@" "sink=$notetaker_sink" \
			latency_msec=40 sink_dont_move=true >/dev/null \
			|| { notetaker_audio_off true; die 'Could not route the microphone into the Notetaker mix.'; }
		pactl load-module module-loopback "source=@DEFAULT_MONITOR@" "sink=$notetaker_sink" \
			latency_msec=40 sink_dont_move=true >/dev/null \
			|| { notetaker_audio_off true; die 'Could not route system audio into the Notetaker mix.'; }
		$quiet || printf 'Notetaker audio mix created: select "%s" as the microphone in Wispr Flow when recording a meeting.\n' "$notetaker_description"
	fi
	if ! $quiet; then
		local monitor_state
		if ! monitor_state="$(system_audio_check 2>/dev/null)"; then
			printf 'WARNING: %s. Run wispr-flow --system-audio fix.\n' \
				"${monitor_state:-the default output monitor volume could not be read}" >&2
		fi
	fi
	mkdir -p "$port_state_dir"
	printf 'on\n' > "$notetaker_flag"
}

notetaker_audio_off() {
	local quiet="${1:-false}" id count=0
	if pulse_ready; then
		while read -r id; do
			[[ -n $id ]] || continue
			pactl unload-module "$id" 2>/dev/null && count=$((count + 1))
		done < <(notetaker_module_ids | sort -rn)
	fi
	rm -f "$notetaker_flag"
	$quiet || printf 'Notetaker audio mix removed (%s module(s) unloaded).\n' "$count"
}

notetaker_audio_status() {
	local flag='off'
	[[ -f $notetaker_flag ]] && flag='on'
	printf 'Notetaker audio mix preference: %s\n' "$flag"
	if ! pulse_ready; then
		printf 'PipeWire PulseAudio server: not reachable\n'
		return 1
	fi
	local monitor_state
	if monitor_state="$(system_audio_check 2>/dev/null)"; then
		printf '%s\n' "$monitor_state"
	else
		printf '%s (run wispr-flow --system-audio fix)\n' "${monitor_state:-Default output monitor volume unreadable}"
	fi
	if notetaker_sink_present; then
		printf 'Mix sink %s: present (%s module(s))\n' "$notetaker_sink" "$(notetaker_module_ids | wc -l | tr -d ' ')"
		printf 'Default input: %s\nDefault output: %s\n' \
			"$(pactl get-default-source 2>/dev/null)" "$(pactl get-default-sink 2>/dev/null)"
		return 0
	fi
	printf 'Mix sink %s: absent\n' "$notetaker_sink"
	[[ $flag == on ]] && return 1
	return 0
}

configure_notetaker_audio() {
	case "${1:-}" in
		on) notetaker_audio_on false ;;
		off) notetaker_audio_off false ;;
		status) notetaker_audio_status ;;
		ensure)
			# Called by the launcher on every start: recreate the mix only when the
			# user turned it on before; stay silent otherwise.
			[[ -f $notetaker_flag ]] || return 0
			pulse_ready || return 0
			notetaker_sink_present && return 0
			notetaker_audio_on true
			;;
		*) die 'Usage: wispr-flow --notetaker-audio on|off|status' ;;
	esac
}

# ---------------------------------------------------------------------------
case "${1:-}" in
	bootstrap)
		hide=false
		[[ ${2:-} == --hide-flow-bar ]] && hide=true
		rewrite_config "$hide"
		key="$(ptt_shortcut)"
		printf 'Linux push-to-talk shortcut: %s\n' "$(shortcut_label "$key")"
		if $hide; then
			printf 'Flow Bar hidden: on Hyprland the persistent bar would leave an invisible surface that swallows clicks.\n'
		fi
		;;
	fix-shortcut)
		rewrite_config false true
		printf 'Push-to-talk shortcut reset to Ctrl+Shift. Restart Wispr Flow.\n'
		;;
	flow-bar)
		have_jq
		[[ -f $config_file ]] || die 'Run Wispr Flow once before changing the Flow Bar.'
		case "${2:-}" in
			on) value=false ;;
			off) value=true ;;
			*) die 'Usage: wispr-flow --flow-bar on|off' ;;
		esac
		tmp="$(mktemp "$config_dir/config.json.XXXXXX")"
		jq --argjson value "$value" \
			'.prefs.user.hideFlowBarPermanently = $value' "$config_file" > "$tmp"
		mv "$tmp" "$config_file"
		chmod 0600 "$config_file"
		printf 'Flow Bar: %s. Restart Wispr Flow.\n' "${2}"
		;;
	check)
		have_jq
		if [[ -f $config_file ]] && jq -e '
			[.prefs.user.shortcuts // {} | to_entries[] |
				select(.value == "ptt" and (.key | test("^-?[0-9]+(\\+-?[0-9]+)+$")))] as $keys |
			($keys[0].key | split("+") | map(tonumber)) as $codes |
			($keys | length) == 1 and
			(.prefs.cache.splitKeybinds // [] | any(.value == "ptt" and .shortcut == $codes))
		' "$config_file" >/dev/null; then
			key="$(ptt_shortcut)"
			printf '[PASS] Linux push-to-talk shortcut: %s\n' "$(shortcut_label "$key")"
		else
			printf '[FAIL] Push-to-talk shortcut is not valid on Linux; run wispr-flow --fix-shortcut\n'
			exit 1
		fi
		;;
	hyprland-rules)
		configure_hyprland_rules "${2:-}"
		;;
	autostart)
		configure_autostart "${2:-}"
		;;
	notetaker-audio)
		configure_notetaker_audio "${2:-}"
		;;
	system-audio)
		configure_system_audio "${2:-}" "${3:-}"
		;;
	notetaker-mic)
		configure_notetaker_mic "${2:-}"
		;;
	integration-mode)
		hypr_entry_mode
		printf '\n'
		;;
	*)
		cat >&2 <<'USAGE'
Usage: wispr-flow-configure <command>
  bootstrap [--hide-flow-bar]     write a Linux-safe Wispr Flow config.json
  fix-shortcut                    reset push-to-talk to Ctrl+Shift
  flow-bar on|off                 persistent Flow Bar vs transient indicator
  check                           verify the push-to-talk shortcut
  hyprland-rules on|off|check     managed Hyprland window rules
  autostart on|off|status         start Wispr Flow with the Hyprland session
  notetaker-audio on|off|status   PipeWire mix of microphone + system audio
  notetaker-mic on|off|status     echo-cancelled microphone (PipeWire WebRTC canceller, default input)
  system-audio check|fix          default output's monitor volume (read by both Notetaker paths)
  system-audio guard [PID]        keep that monitor at 100% until PID exits (started by the launcher)
  integration-mode                print omarchy, lua or conf
USAGE
		exit 2
		;;
esac
